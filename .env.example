# Development settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Only needed if you replace the demo payment flow with real Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email OTP (see OTP_AND_GOOGLE_SETUP.txt) ----
# Leave these empty to just PRINT the OTP email in the terminal while testing.
# Fill both to send real emails through Gmail.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Continue with Google (see OTP_AND_GOOGLE_SETUP.txt) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
