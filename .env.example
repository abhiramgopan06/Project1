# Copy this file to .env in the same folder as manage.py.
# Do not commit .env to GitHub. Never put your App Password in this example file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Gmail sender account (the address used to send OTP emails)
EMAIL_HOST_USER=abhiramgopan06@gmail.com
# Add your Google 16-character App Password to .env only.
EMAIL_HOST_PASSWORD=

# Optional Google sign-in settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Razorpay settings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
